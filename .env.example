# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Privy (dashboard.privy.io → your app → App settings). Required for the dashboard's sign-in. The app must
# list this site's domain (execute.cash, and localhost for development) under its allowed domains.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: only if you created a dedicated web client in Privy.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# execute-server, called server-side only (the /api/execute proxy and the address pages).
# Locally: http://127.0.0.1:8090. Default: https://api.execute.cash
EXECUTE_API_URL=
# Shown in code snippets. Default: https://api.execute.cash
NEXT_PUBLIC_EXECUTE_API_URL=

# An API key of Execute's own demo account, for the live demo in the docs' quickstart. Server-only.
EXECUTE_DEMO_API_KEY=

# A Base JSON-RPC endpoint for /bitso (the vault quote behind each address, and the wallet's collateral). Server-only.
# Default: https://mainnet.base.org, which is rate limited.
BASE_RPC_URL=
